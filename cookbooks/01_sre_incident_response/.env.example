# Copy to .env and fill in. The harness fails closed without a real API key (no subscription
# fallback), so the reported cost reflects real Anthropic API billing.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# NAVFLOW_MODEL=claude-sonnet-4-6            # default: claude-opus-4-8
# NAVFLOWD_URL=http://127.0.0.1:8787         # the `navflow up` daemon
# NAVFLOW_MCP_URL=http://127.0.0.1:8788/mcp  # the `navflow mcp` agent endpoint
# NAVFLOW_COOKBOOK_NS=sre_                    # prefix for the cookbook's own NavFlow objects
